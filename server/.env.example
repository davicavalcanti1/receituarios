SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=3001

# ── Integração NetRis (OPCIONAL) ─────────────────────────────────────────────
# O módulo funciona sem ela: a importação manual (colar planilha / .csv) é o
# caminho principal. Com NETRIS_BASE_URL e NETRIS_TOKEN preenchidos, a aba
# "Buscar por data" aparece no Novo Lote; sem eles, a aba nem é renderizada e
# /api/netris/* responde 503. Ligar ou desligar não exige rebuild — é env var
# e restart, porque o front descobre pelo GET /api/config.
NETRIS_BASE_URL=
NETRIS_TOKEN=
NETRIS_FILIAL_ID=1
